    {
      "skill_name": "execute_gift_issue",
      "display_name": "专属礼物发放",
      "description": "支持用户专属/直播间专属/随机礼物发放，支持批量发放给多个用户/直播间",
      "skill_type": "execute",
      "server_name": "gift-management-server",
      "tool_name": "add_gift_to_exclusive_tab",
      "priority": 18,
      "risk_level": "medium",
      "match_keywords": [
        "发放专属礼物",
        "专属礼物",
        "批量发礼物",
        "发放礼物",
        "用户专属",
        "直播间专属",
        "随机礼物",
        "批量发放"
      ],
      "match_entities": [
        "专属",
        "礼物",
        "用户",
        "直播间",
        "批量"
      ],
      "param_schema": {
        "gift_id": {
          "type": "integer",
          "required": true,
          "description": "礼物ID，2开头=用户专属，7开头=直播间专属，8开头=随机礼物",
          "alias": [
            "礼物ID",
            "礼品ID"
          ],
          "validation": {
            "pattern": "^[278]\\d{4,}$",
            "message": "礼物ID必须以2/7/8开头"
          }
        },
        "target_id": {
          "type": "integer",
          "required": false,
          "description": "目标ID：用户专属=用户ID，直播间专属=直播间ID（单个发放时使用）",
          "alias": [
            "用户ID",
            "直播间ID",
            "user_id",
            "room_id"
          ],
          "validation": {
            "min": 1,
            "max": 99999999999,
            "message": "目标ID必须在1-99999999999之间"
          }
        },
        "user_ids": {
          "type": "array",
          "required": false,
          "description": "用户ID列表（批量发放给多个用户时使用）",
          "alias": [
            "用户列表",
            "用户ID列表"
          ]
        },
        "gift_ids": {
          "type": "array",
          "required": false,
          "description": "礼物ID列表（给同一目标批量发放多个礼物）",
          "alias": [
            "礼物列表",
            "礼物ID列表"
          ]
        },
        "room_ids": {
          "type": "array",
          "required": false,
          "description": "直播间ID列表（批量发放给多个直播间时使用）",
          "alias": [
            "直播间列表",
            "房间ID列表"
          ]
        },
        "issue_type": {
          "type": "string",
          "required": false,
          "default": "user",
          "description": "发放类型：user=用户专属，room=直播间专属，random=随机礼物",
          "enum": [
            "user",
            "room",
            "random"
          ],
          "alias": [
            "发放类型",
            "类型"
          ]
        },
        "duration_days": {
          "type": "integer",
          "required": false,
          "default": 7,
          "description": "有效期天数，1000=永久有效",
          "alias": [
            "有效期",
            "天数"
          ],
          "validation": {
            "min": 1,
            "max": 1000,
            "message": "有效期必须在1-1000天之间"
          },
          "special_values": {
            "永久": 1000,
            "永久有效": 1000
          }
        },
        "batch_count": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "批量发放数量（给同一个用户重复发放N次），最大100",
          "alias": [
            "数量",
            "批量数"
          ],
          "validation": {
            "min": 1,
            "max": 100,
            "message": "批量数量必须在1-100之间"
          }
        }
      },
      "batch_config": {
        "enabled": true,
        "rules": [
          {
            "source_param": "user_ids",
            "target_param": "target_id"
          },
          {
            "source_param": "room_ids",
            "target_param": "target_id"
          },
          {
            "source_param": "gift_ids",
            "target_param": "gift_id"
          }
        ]
      }
    },
