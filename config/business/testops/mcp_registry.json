          "method": "POST",
          "path": "/tools/query_user_info",
          "params": [
            {
              "name": "user_id",
              "type": "integer",
              "required": false,
              "desc": "用户ID"
            },
            {
              "name": "room_id",
              "type": "integer",
              "required": false,
              "desc": "直播间ID"
            },
            {
              "name": "email",
              "type": "string",
              "required": false,
              "desc": "邮箱"
            },
            {
              "name": "phone",
              "type": "string",
              "required": false,
              "desc": "手机号"
            }
          ]
        }
      ],
      "isActive": true,
      "isTrusted": true
    },
    "config-check-server": {
      "id": "config-check-server",
      "name": "配置核验-外观/奖励有效期",
      "type": "streamableHttp",
      "baseUrl": "local",
      "headers": {
        "Content-Type": "application/json"
      },
      "tools": [
        {
          "toolName": "query_appearance_config",
          "toolDesc": "查询外观资源配置（ID、类型、名称、有效期、最大有效期），从test_appearances和test_rewards集合查询，无结果提示未配置该外观",
          "method": "POST",
          "path": "/tools/query_appearance_config",
          "ignoreReadTimeout": true,
          "params": [
            {
              "name": "appearance_id",
              "type": "integer",
              "required": true,
              "desc": "外观ID"
            }
          ]
        },
        {
          "toolName": "query_appearance_configs_batch",
          "toolDesc": "批量查询外观资源配置（支持逗号分隔的ID列表）",
          "method": "POST",
          "path": "/tools/query_appearance_configs_batch",
          "ignoreReadTimeout": true,
          "params": [
            {
              "name": "appearance_ids",
              "type": "string",
              "required": true,
              "desc": "外观ID列表，逗号分隔，如 40667,40789"
            }
          ]
        },
        {
          "toolName": "query_reward_config",
          "toolDesc": "查询奖励配置（reward_id、礼物id element_id、活动id event_id、礼物类型、有效期duration、最大有效期end_time），从test_rewards集合查询，无结果提示未配置该奖励",
          "method": "POST",
          "path": "/tools/query_reward_config",
          "params": [
            {
              "name": "reward_id",
              "type": "integer",
              "required": false,
              "desc": "奖励ID"
            },
            {
              "name": "element_id",
              "type": "integer",
              "required": false,
              "desc": "礼物ID或外观ID"
            },
            {
              "name": "event_id",
              "type": "integer",
              "required": false,
              "desc": "活动ID"
            }
          ]
        },
        {
          "toolName": "query_reward_configs_batch",
          "toolDesc": "批量查询奖励配置（支持逗号分隔的ID列表）",
          "method": "POST",
          "path": "/tools/query_reward_configs_batch",
