{
  "redis": {
    "enabled": true,
    "host": "${REDIS_HOST:localhost}",
    "port": "${REDIS_PORT:6379}",
    "db": "${REDIS_DB:0}",
    "password": "${REDIS_PASSWORD:}",
    "socket_timeout": 5,
    "socket_connect_timeout": 5,
    "decode_responses": true,
    "max_connections": 50,
    "health_check_interval": 30
  },
  "idempotent": {
    "use_redis": true,
    "ttl": 300,
    "key_prefix": "idempotent"
  }
}
