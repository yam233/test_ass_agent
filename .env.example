# 外观发放和背包礼物发放 Grafana 后台认证配置
# 从浏览器开发者工具中复制完整的 Cookie 字符串
# 格式：key1=value1; key2=value2; key3=value3
# 
# 用途：
# 1. 外观发放到外观中心平台 (https://internal.example.invalid/api/v2/admin/user/appearance/manage)
# 2. 背包礼物发放 (https://internal.example.invalid/api/v2/admin/user/givegift)
GRAFANA_COOKIES=

# 其他环境变量...

# 可选：Cookie 缓存有效期（秒），默认 3600
GRAFANA_COOKIE_TTL="3600"
